# Local dev values come from `supabase start` output (also visible via `supabase status`).
# For production, use your Supabase Cloud project's values (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_, never import in a Client Component -- it bypasses
# RLS entirely. Used only in Route Handlers running on the Node.js runtime (signup, staff
# creation, PIN counter-login).
#
# Use the LEGACY service_role key (a long eyJ... JWT, under Project Settings -> API Keys ->
# "Legacy API Keys"), NOT the new sb_secret_... format. As of this writing, GoTrue's admin
# endpoints (used by supabase.auth.admin.createUser, which every staff-creation/signup route
# here depends on) reject the new secret-key format with "unrecognized JWT kid" -- confirmed via
# the project's auth logs while building this phase, not a guess.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to HMAC-sign the counter-login cookie. Generate with: openssl rand -hex 32
COUNTER_SESSION_SECRET=

# Optional. International format, no leading "+" (e.g. "923001234567") -- the number shopkeepers
# WhatsApp to subscribe once their trial banner appears (src/app/(dashboard)/trial-banner.tsx), and
# to reach support from the /account-suspended page. Left unset here deliberately rather than
# filled with a placeholder: this is Ahmad's own business contact, not something to guess at. Both
# banners degrade gracefully to plain text when unset.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Platform admin panel -- notification channels (src/lib/notifications/**). Each is optional and
# independently skip-if-unset: leaving one blank just means that channel shows as "not configured"
# in the admin UI's notify form rather than failing the send.

# Email, via Resend's HTTP API directly (no SDK). A brand-new Resend account can only send to the
# account owner's own verified email until a sending domain is DNS-verified (SPF/DKIM) -- plan
# around that when testing real sends.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp Business Cloud API. Needs Meta Business verification + an approved message template
# before it can actually send -- src/lib/notifications/channels/whatsapp.ts is wired up but
# deliberately stubbed (always returns "skipped") until that's done, regardless of these being set.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
